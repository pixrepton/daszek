# Daszek - WordPress Plugin Protection

# Zapobiegaj bezpośredniemu dostępowi do plików PHP
<FilesMatch "\.(php|inc)$">
    <IfModule mod_authz_core.c>
        # Apache 2.4
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        # Apache 2.2
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

# Wyjątki: publiczne endpointy (obsługiwane przez WordPress)
<FilesMatch "^(daszek\.php)$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Allow from all
    </IfModule>
</FilesMatch>

# Zapobiegaj listowaniu katalogów
Options -Indexes

# Ochrona plików konfiguracyjnych
<FilesMatch "^(composer\.json|package\.json|\.gitignore|\.htaccess)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>
